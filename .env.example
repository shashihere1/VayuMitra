# ============================================================================
# VayuMitra configuration.  Copy to .env and edit for your venue/network.
#   cp .env.example .env      (setup.ps1 does this for you)
# ============================================================================

# --- MQTT broker (the single Mosquitto broker on the AI PC) ---
MQTT_HOST=127.0.0.1         # laptop LAN IP (broker). 127.0.0.1 for laptop-only.
MQTT_PORT=1883

# --- device / user identity ---
DEVICE_ID=unoq-01
USER_ID=demo-user
DEVICE_LAT=19.0760          # for nearest-safe-zone + navigation (Mumbai here)
DEVICE_LON=72.8777

# --- sensors (all read on the MCU sketch; these constants live in the sketch,
#     mirrored here for docs and for the --mock publisher) ---
BME_VARIANT=bme680          # bme680 | bme690
BME_I2C_ADDR=0x76
DUST_LED_PIN=2              # GP2Y1010 LED-pulse control GPIO
DUST_ADC_PIN=A0            # GP2Y1010 Vo (through the divider), <=3.3 V
DUST_DIVIDER=1.5           # Vo divider ratio used in the voltage reconstruction
DUST_VOC_OFFSET=0.6        # clean-air Voc (V) - calibrate per unit

# --- software toggles (every optional path degrades gracefully) ---
USE_NPU=true                # false forces CPU
USE_FOUNDRY=true            # false forces template advisories
FOUNDRY_MODEL=phi-4-mini

# --- cascade thresholds (hysteresis) ---
RISK_CRITICAL=75
RISK_WARNING=50
RISK_CLEAR=60

# --- server ports ---
API_PORT=8000
DASHBOARD_PORT=8501
